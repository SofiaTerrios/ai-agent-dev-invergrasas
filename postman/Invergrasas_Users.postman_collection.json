    {
      "name": "Empresas",
      "item": [
        {
          "name": "Create Empresa",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"razon_social\": \"Invergrasas Principal S.A.S\",\n    \"nit\": \"900123456-1\",\n    \"direccion\": \"Calle 123 # 45-67\",\n    \"telefono\": \"+573001234567\",\n    \"correo\": \"contacto@invergrasas.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/empresas",
              "host": ["{{base_url}}"],
              "path": ["api", "empresas"]
            }
          }
        },
        {
          "name": "Edit Empresa",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"direccion\": \"Avenida Nueva # 89-01\",\n    \"telefono\": \"+573119876543\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/empresas/{{empresa_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "empresas", "{{empresa_id}}"]
            }
          }
        },
        {
          "name": "List User Empresas",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/empresas",
              "host": ["{{base_url}}"],
              "path": ["api", "empresas"]
            }
          }
        },
        {
          "name": "Associate User to Empresa",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"userId\": \"{{user_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/empresas/{{empresa_id}}/users",
              "host": ["{{base_url}}"],
              "path": ["api", "empresas", "{{empresa_id}}", "users"]
