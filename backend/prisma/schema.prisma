generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Rol global del usuario. El acceso por empresa se controla con UserEmpresa.
// Permisos por módulo y acción: src/auth/roles.ts
enum Rol {
  super_admin
  admin
  comercial
  calidad
  entrega
  empleado
}

// deleted_at marca al usuario como desactivado: no puede iniciar sesión.
model User {
  id                      String                @id @default(uuid())
  nombre                  String
  email                   String                @unique
  password                String
  rol                     Rol                   @default(empleado)
  documento               String?
  telefono                String?
  // Se pide cambiar la contraseña en el próximo ingreso
  debe_cambiar_password   Boolean               @default(false)
  // Imagen de la firma (rol entrega, para los recibos)
  firma                   Bytes?
  firma_mime              String?
  // Conductores (rol entrega): vehículo que se precarga en sus movimientos
  vehiculo_por_defecto_id String?
  created_at              DateTime              @default(now())
  deleted_at              DateTime?
  empresas                UserEmpresa[]
  auditoria               AuditLog[]
  certificadosFirmados    CertificadoAnalisis[] @relation("CertificadoFirmante")
  certificadosEmitidos    CertificadoAnalisis[] @relation("CertificadoEmisor")
  certificadosAnulados    CertificadoAnalisis[] @relation("CertificadoAnulador")
  vehiculo_por_defecto    Vehiculo?             @relation(fields: [vehiculo_por_defecto_id], references: [id], onDelete: SetNull)
  movimientosEntregados   Movimiento[]          @relation("MovimientoEntrega")
  movimientosCreados      Movimiento[]          @relation("MovimientoCreador")
  movimientosAnulados     Movimiento[]          @relation("MovimientoAnulador")
  ajustesInventario       InventarioEnvase[]

  @@map("users")
}

// Acciones sensibles (cambios de rol, alta/baja de usuarios, anulaciones).
model AuditLog {
  id         String    @id @default(uuid())
  // Null cuando la acción la hace un comando (p. ej. crear el primer super admin)
  actor_id   String?
  accion     String
  entidad    String
  entidad_id String?
  detalle    Json?
  created_at DateTime  @default(now())
  deleted_at DateTime?
  actor      User?     @relation(fields: [actor_id], references: [id], onDelete: Restrict)

  @@index([actor_id])
  @@index([entidad, entidad_id])
  @@map("audit_logs")
}

model Empresa {
  id           String                @id @default(uuid())
  razon_social String
  nit          String                @unique
  direccion    String?
  telefono     String?
  correo       String?
  created_at   DateTime              @default(now())
  deleted_at   DateTime?
  users        UserEmpresa[]
  clientes     Cliente[]
  certificados CertificadoAnalisis[]
  vehiculos    Vehiculo[]
  movimientos  Movimiento[]
  inventario   InventarioEnvase[]

  @@map("empresas")
}

model UserEmpresa {
  id         String    @id @default(uuid())
  user_id    String
  empresa_id String
  created_at DateTime  @default(now())
  deleted_at DateTime?
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  empresa    Empresa   @relation(fields: [empresa_id], references: [id], onDelete: Cascade)

  @@unique([user_id, empresa_id])
  @@index([user_id])
  @@index([empresa_id])
  @@map("user_empresas")
}

// Papeles de una empresa cliente en los certificados (IG-36). Puede tener varios.
enum TipoEmpresa {
  GENERADOR
  TRANSPORTADOR
  DESTINO
  GESTOR
}

// Empresa con la que trabaja Invergrasas (IG-36). empresa_id es el tenant:
// la empresa de Invergrasas dueña del registro.
model Cliente {
  id           String                @id @default(uuid())
  razon_social String
  // Null solo en clientes migrados que aún no tienen NIT (dato incompleto)
  nit          String?
  // Dígito de verificación, calculado del NIT
  dv           String?
  // Registro ambiental o sanitario
  registro     String?
  ciudad_id    String?
  tipos        TipoEmpresa[]         @default([GENERADOR])
  empresa_id   String
  created_at   DateTime              @default(now())
  updated_at   DateTime              @default(now()) @updatedAt
  deleted_at   DateTime?
  empresa      Empresa               @relation(fields: [empresa_id], references: [id], onDelete: Restrict)
  ciudad       Ciudad?               @relation(fields: [ciudad_id], references: [id], onDelete: Restrict)
  certificados CertificadoAnalisis[]
  sedes        Sede[]
  contactos    Contacto[]
  vehiculos    Vehiculo[]
  movimientos  Movimiento[]          @relation("MovimientoCliente")
  transportes  Movimiento[]          @relation("MovimientoTransportador")
  destinos     Movimiento[]          @relation("MovimientoDestino")
  inventario   InventarioEnvase[]

  // El NIT no se repite dentro de un tenant (los borrados lo siguen ocupando)
  @@unique([empresa_id, nit])
  @@index([empresa_id])
  @@map("clientes")
}

// Municipios de Colombia (DIVIPOLA del DANE), cargados en la migración (IG-35).
model Ciudad {
  id              String    @id @default(uuid())
  codigo_dane     String    @unique
  nombre          String
  departamento    String
  // Nombre en minúsculas y sin tildes, para buscar "bogota" o "soa"
  nombre_busqueda String
  deleted_at      DateTime?
  clientes        Cliente[]
  sedes           Sede[]

  @@index([nombre_busqueda])
  @@map("ciudades")
}

model ActividadEconomica {
  id         String    @id @default(uuid())
  nombre     String    @unique
  created_at DateTime  @default(now())
  deleted_at DateTime?
  sedes      Sede[]

  @@map("actividades_economicas")
}

// Local de un cliente (IG-37). Desactivar = borrado lógico. Cada cliente tiene
// exactamente una sede principal activa (lo garantiza el servicio).
model Sede {
  id                     String              @id @default(uuid())
  cliente_id             String
  nombre                 String
  actividad_economica_id String?
  // Opcionales solo por los clientes migrados; la API los pide al crear
  direccion              String?
  telefono               String?
  barrio                 String?
  localidad              String?
  email                  String?
  ciudad_id              String?
  principal              Boolean             @default(false)
  created_at             DateTime            @default(now())
  updated_at             DateTime            @default(now()) @updatedAt
  deleted_at             DateTime?
  cliente                Cliente             @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  actividad_economica    ActividadEconomica? @relation(fields: [actividad_economica_id], references: [id], onDelete: Restrict)
  ciudad                 Ciudad?             @relation(fields: [ciudad_id], references: [id], onDelete: Restrict)
  contactos              Contacto[]
  movimientos            Movimiento[]

  @@index([cliente_id])
  @@map("sedes")
}

// Persona del cliente que recibe o entrega (IG-38). No es usuario del sistema.
model Contacto {
  id          String       @id @default(uuid())
  cliente_id  String
  sede_id     String?
  nombre      String
  documento   String?
  cargo       String?
  telefono    String?
  email       String?
  created_at  DateTime     @default(now())
  updated_at  DateTime     @default(now()) @updatedAt
  deleted_at  DateTime?
  cliente     Cliente      @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  sede        Sede?        @relation(fields: [sede_id], references: [id], onDelete: Restrict)
  movimientos Movimiento[]

  @@index([cliente_id])
  @@map("contactos")
}

// Catálogo de productos que se entregan (IG-26)
model Producto {
  id          String            @id @default(uuid())
  nombre      String            @unique
  descripcion String?
  created_at  DateTime          @default(now())
  deleted_at  DateTime?
  empaques    ProductoEmpaque[]
  lineas      MovimientoLinea[]

  @@map("productos")
}

// Galón, caneca, bidón, granel... Los retornables cuentan en el inventario de envases.
model TipoEmpaque {
  id         String             @id @default(uuid())
  nombre     String             @unique
  capacidad  Decimal?           @db.Decimal(10, 2)
  unidad     String?
  retornable Boolean            @default(false)
  created_at DateTime           @default(now())
  deleted_at DateTime?
  productos  ProductoEmpaque[]
  lineas     MovimientoLinea[]
  inventario InventarioEnvase[]

  @@map("tipos_empaque")
}

// Combinaciones válidas de producto y empaque (p. ej. oleína en galón)
model ProductoEmpaque {
  id              String      @id @default(uuid())
  producto_id     String
  tipo_empaque_id String
  created_at      DateTime    @default(now())
  deleted_at      DateTime?
  producto        Producto    @relation(fields: [producto_id], references: [id], onDelete: Restrict)
  tipo_empaque    TipoEmpaque @relation(fields: [tipo_empaque_id], references: [id], onDelete: Restrict)

  @@unique([producto_id, tipo_empaque_id])
  @@map("productos_empaques")
}

// Vehículo de una empresa transportadora (IG-40). empresa_id es el tenant.
model Vehiculo {
  id               String       @id @default(uuid())
  empresa_id       String
  // Cliente con tipo TRANSPORTADOR
  transportador_id String
  // Mayúsculas, formato "ABC 123"
  placa            String
  descripcion      String?
  created_at       DateTime     @default(now())
  updated_at       DateTime     @default(now()) @updatedAt
  deleted_at       DateTime?
  empresa          Empresa      @relation(fields: [empresa_id], references: [id], onDelete: Restrict)
  transportador    Cliente      @relation(fields: [transportador_id], references: [id], onDelete: Restrict)
  conductores      User[]
  movimientos      Movimiento[]

  @@unique([empresa_id, placa])
  @@index([transportador_id])
  @@map("vehiculos")
}

enum CertificadoTipo {
  oleina
  rbd
}

model CertificadoAnalisis {
  id                String               @id @default(uuid())
  // Tenant. Nullable only for legacy rows that could not be backfilled.
  empresa_id        String?
  cliente_id        String?
  tipo              CertificadoTipo
  empresa_cliente   String
  nit_cliente       String?
  lote              String
  peso_kg           Decimal?             @db.Decimal(10, 2)
  fecha_emision     DateTime             @default(now())
  fecha_vencimiento DateTime
  // Name of the firmante when it was issued: later changes do not alter it
  firmado_por       String
  firmante_id       String?
  // User who generated it
  emitido_por       String?
  archivo_url       String?
  // Anulado: stays in the history (and its PDF), marked as not valid
  anulado_at        DateTime?
  anulado_por       String?
  motivo_anulacion  String?
  // Anulado certificado this one corrects
  reemplaza_id      String?              @unique
  created_at        DateTime             @default(now())
  deleted_at        DateTime?
  parametros        ParametroAnalisis[]
  empresa           Empresa?             @relation(fields: [empresa_id], references: [id], onDelete: Restrict)
  cliente           Cliente?             @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  firmante          User?                @relation("CertificadoFirmante", fields: [firmante_id], references: [id], onDelete: Restrict)
  emisor            User?                @relation("CertificadoEmisor", fields: [emitido_por], references: [id], onDelete: Restrict)
  anulador          User?                @relation("CertificadoAnulador", fields: [anulado_por], references: [id], onDelete: Restrict)
  reemplaza         CertificadoAnalisis? @relation("Reemplazo", fields: [reemplaza_id], references: [id], onDelete: Restrict)
  reemplazado_por   CertificadoAnalisis? @relation("Reemplazo")

  @@index([empresa_id])
  @@index([cliente_id])
  @@index([fecha_emision])
  @@map("certificados_analisis")
}

// System settings editable by the super admin (e.g. the certificado firmante).
model Configuracion {
  clave      String    @id
  valor      String
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  @@map("configuracion")
}

model ParametroAnalisis {
  id             String              @id @default(uuid())
  certificado_id String
  nombre         String
  valor          String
  orden          Int
  deleted_at     DateTime?
  certificado    CertificadoAnalisis @relation(fields: [certificado_id], references: [id], onDelete: Cascade)

  @@index([certificado_id])
  @@map("parametros_analisis")
}

// ── Entregas y recolecciones (IG-39, IG-27, IG-28, IG-30, IG-31) ────────────

enum TipoMovimiento {
  ENTREGA
  RECOLECCION
  ENTREGA_Y_RECOLECCION
}

// Visita a un cliente: entrega de producto, recolección de envases o ambas.
// Su certificado (PDF) sale del snapshot, nunca de los datos actuales.
model Movimiento {
  id                 String             @id @default(uuid())
  empresa_id         String
  // Consecutivo por empresa y año, asignado en el backend (SecuenciaMovimiento)
  numero             Int
  anio               Int
  tipo               TipoMovimiento
  fecha              DateTime           @db.Date
  cliente_id         String
  sede_id            String?
  contacto_id        String?
  // Conductor (rol entrega): firma el certificado
  usuario_entrega_id String
  vehiculo_id        String?
  transportador_id   String?
  destino_id         String?
  observacion        String?
  // Copia de cliente, sede, contacto, conductor, vehículo, transportador y destino al emitir
  snapshot           Json
  // Firma del conductor al emitir
  firma_entrega      Bytes?
  firma_entrega_mime String?
  archivo_url        String?
  creado_por         String
  anulado_at         DateTime?
  anulado_por        String?
  motivo_anulacion   String?
  // Pedido del que viene, en los movimientos migrados de la tabla pedidos
  origen_pedido_id   String?            @unique
  created_at         DateTime           @default(now())
  deleted_at         DateTime?
  empresa            Empresa            @relation(fields: [empresa_id], references: [id], onDelete: Restrict)
  cliente            Cliente            @relation("MovimientoCliente", fields: [cliente_id], references: [id], onDelete: Restrict)
  sede               Sede?              @relation(fields: [sede_id], references: [id], onDelete: Restrict)
  contacto           Contacto?          @relation(fields: [contacto_id], references: [id], onDelete: Restrict)
  usuario_entrega    User               @relation("MovimientoEntrega", fields: [usuario_entrega_id], references: [id], onDelete: Restrict)
  vehiculo           Vehiculo?          @relation(fields: [vehiculo_id], references: [id], onDelete: Restrict)
  transportador      Cliente?           @relation("MovimientoTransportador", fields: [transportador_id], references: [id], onDelete: Restrict)
  destino            Cliente?           @relation("MovimientoDestino", fields: [destino_id], references: [id], onDelete: Restrict)
  creador            User               @relation("MovimientoCreador", fields: [creado_por], references: [id], onDelete: Restrict)
  anulador           User?              @relation("MovimientoAnulador", fields: [anulado_por], references: [id], onDelete: Restrict)
  lineas             MovimientoLinea[]
  inventario         InventarioEnvase[]

  @@unique([empresa_id, anio, numero])
  @@index([cliente_id])
  @@index([usuario_entrega_id])
  @@index([fecha])
  @@map("movimientos")
}

model MovimientoLinea {
  id                String      @id @default(uuid())
  movimiento_id     String
  orden             Int
  // Null en líneas de solo recolección
  producto_id       String?
  // kg, galón o litro
  unidad_medida     String?
  cantidad          Decimal?    @db.Decimal(12, 2)
  tipo_empaque_id   String
  // Envases llenos entregados
  cantidad_envases  Int         @default(0)
  vacios_recibidos  Int         @default(0)
  vacios_entregados Int         @default(0)
  deleted_at        DateTime?
  movimiento        Movimiento  @relation(fields: [movimiento_id], references: [id], onDelete: Restrict)
  producto          Producto?   @relation(fields: [producto_id], references: [id], onDelete: Restrict)
  tipo_empaque      TipoEmpaque @relation(fields: [tipo_empaque_id], references: [id], onDelete: Restrict)

  @@index([movimiento_id])
  @@map("movimiento_lineas")
}

// Último consecutivo usado por empresa y año. Se incrementa con un UPSERT
// atómico, así dos emisiones simultáneas nunca reciben el mismo número.
model SecuenciaMovimiento {
  empresa_id String
  anio       Int
  ultimo     Int
  deleted_at DateTime?

  @@id([empresa_id, anio])
  @@map("secuencias_movimiento")
}

// Libro de envases retornables por cliente (IG-31): + entregados al cliente,
// - recogidos. El saldo es la suma, sin contar movimientos anulados.
model InventarioEnvase {
  id              String      @id @default(uuid())
  empresa_id      String
  cliente_id      String
  tipo_empaque_id String
  cantidad        Int
  // Null en los ajustes manuales (saldo inicial)
  movimiento_id   String?
  motivo          String?
  creado_por      String?
  fecha           DateTime    @db.Date
  created_at      DateTime    @default(now())
  deleted_at      DateTime?
  empresa         Empresa     @relation(fields: [empresa_id], references: [id], onDelete: Restrict)
  cliente         Cliente     @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  tipo_empaque    TipoEmpaque @relation(fields: [tipo_empaque_id], references: [id], onDelete: Restrict)
  movimiento      Movimiento? @relation(fields: [movimiento_id], references: [id], onDelete: Restrict)
  creador         User?       @relation(fields: [creado_por], references: [id], onDelete: Restrict)

  @@index([cliente_id, tipo_empaque_id])
  @@index([movimiento_id])
  @@map("inventario_envases")
}
