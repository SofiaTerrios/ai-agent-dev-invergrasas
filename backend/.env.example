# Environment variables example for backend
# Copy to .env and customize values before running

# JWT secret used to sign access tokens
JWT_SECRET=invergrasas_secret_change_me

# Database (Postgres) - used by docker-compose.yml
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=invergrasas_dev

# Prisma connection string (app and e2e tests; e2e tests truncate the tables)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/invergrasas_dev

# Max page size for paginated listings (default 100)
PAGINATION_MAX_LIMIT=100

# Folder for generated certificado PDFs (default: backend/static/certificados)
# CERTIFICADOS_DIR=/var/data/certificados

# Public URL of the frontend (CORS)
FRONTEND_URL=http://localhost:3000
