# Environment variables example for backend
# Copy to .env and customize values before running

# JWT secret used to sign access tokens
JWT_SECRET=invergrasas_secret_change_me

# Database (Postgres) - used when running Nest app (not used by tests which use sqlite in-memory)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=invergrasas_dev
